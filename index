<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#000000" />
  <title>Saqib</title>
  <style>
    * { box-sizing: border-box; }

    body {
      min-height: 100vh;
      margin: 0;
      display: grid;
      place-items: center;
      background: #000;
      color: #fff;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    #home h1 {
      margin: 0;
      font-size: clamp(3rem, 12vw, 6rem);
      font-weight: 600;
      letter-spacing: 0.04em;
    }

    #admin {
      display: none;
      width: min(92vw, 640px);
      max-height: 85vh;
      overflow: auto;
      padding: 1.5rem;
      border: 1px solid #333;
      border-radius: 12px;
      background: #101010;
    }

    .admin-header, .visit-count, .actions {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }

    .admin-header { border-bottom: 1px solid #292929; padding-bottom: 1rem; }
    .admin-header h2 { margin: 0; font-size: 1.2rem; }
    .visit-count { margin: 1rem 0; padding: 0.9rem 1rem; border-radius: 8px; background: #1b1b1b; }

    #visits {
      margin: 0;
      padding: 0.75rem 1rem;
      list-style: none;
      border: 1px solid #292929;
      border-radius: 8px;
      background: #080808;
      color: #ddd;
      font: 0.9rem/1.6 ui-monospace, SFMono-Regular, Menlo, monospace;
    }

    #visits li + li { border-top: 1px solid #222; }
    #visits li { padding: 0.5rem 0; overflow-wrap: anywhere; }
    .actions { justify-content: flex-end; margin-top: 1rem; }

    button {
      padding: 0.55rem 0.85rem;
      border: 1px solid #444;
      border-radius: 6px;
      background: #222;
      color: #fff;
      font: inherit;
      cursor: pointer;
    }

    button:hover { background: #333; }
    button:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
    .hint { position: fixed; bottom: 1rem; color: #777; font-size: 0.8rem; }

    @media (max-width: 420px) {
      #admin { padding: 1rem; }
      .admin-header, .visit-count { align-items: flex-start; }
    }
  </style>
</head>
<body>
  <main id="home" aria-label="Home">
    <h1>Saqib</h1>
  </main>

  <section id="admin" aria-labelledby="admin-title" aria-hidden="true">
    <header class="admin-header">
      <h2 id="admin-title">Visit history</h2>
      <button id="close-button" type="button">Close (Esc)</button>
    </header>
    <p class="visit-count">Visits recorded in this browser: <strong id="visit-count">0</strong></p>
    <ul id="visits" aria-live="polite"></ul>
    <div class="actions">
      <button id="clear-button" type="button">Clear this browser's history</button>
    </div>
  </section>

  <p class="hint" id="shortcut-hint">Press Shift twice to open visit history</p>

  <script>
    // This is a local demo: records are stored only in this browser and device.
    const STORAGE_KEY = "saqib_visit_history_v1";
    const home = document.getElementById("home");
    const admin = document.getElementById("admin");
    const visitList = document.getElementById("visits");
    const visitCount = document.getElementById("visit-count");
    const shortcutHint = document.getElementById("shortcut-hint");

    function readVisits() {
      try {
        const value = JSON.parse(localStorage.getItem(STORAGE_KEY) || "[]");
        return Array.isArray(value) ? value : [];
      } catch {
        return [];
      }
    }

    function renderVisits() {
      const visits = readVisits();
      visitCount.textContent = String(visits.length);
      visitList.replaceChildren();

      if (visits.length === 0) {
        const item = document.createElement("li");
        item.textContent = "No visits recorded in this browser yet.";
        visitList.append(item);
        return;
      }

      for (const visit of visits) {
        const item = document.createElement("li");
        item.textContent = new Date(visit).toLocaleString();
        visitList.append(item);
      }
    }

    function setAdminVisible(visible) {
      home.style.display = visible ? "none" : "block";
      admin.style.display = visible ? "block" : "none";
      admin.setAttribute("aria-hidden", String(!visible));
      shortcutHint.hidden = visible;
      if (visible) renderVisits();
    }

    // Record a page visit in this browser's local storage.
    const visits = readVisits();
    visits.unshift(new Date().toISOString());
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(visits.slice(0, 100)));
    } catch {
      // Storage may be disabled or full; the page still works without it.
    }

    let lastShiftTime = 0;
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && admin.style.display === "block") {
        setAdminVisible(false);
        return;
      }

      if (event.key !== "Shift" || event.repeat) return;
      const now = Date.now();
      if (now - lastShiftTime <= 600) {
        setAdminVisible(admin.style.display !== "block");
        lastShiftTime = 0;
      } else {
        lastShiftTime = now;
      }
    });

    document.getElementById("close-button").addEventListener("click", () => setAdminVisible(false));
    document.getElementById("clear-button").addEventListener("click", () => {
      localStorage.removeItem(STORAGE_KEY);
      renderVisits();
    });
  </script>
</body>
</html>
